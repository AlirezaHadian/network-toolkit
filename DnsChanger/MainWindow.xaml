                                <Button x:Name="RunDiagnosticsButton" Content="{DynamicResource Troubleshoot_DiagnoseButton}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="RunDiagnosticsButton_Click"/>
