                                                                <Style TargetType="Rectangle">
                                                                    <Setter Property="Fill" Value="{DynamicResource BorderColor}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Bar2Active}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource AccentBlue}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Rectangle.Style>
                                                        </Rectangle>
                                                        <Rectangle Width="4" Height="14" Canvas.Left="18" Canvas.Top="6" RadiusX="1" RadiusY="1">
