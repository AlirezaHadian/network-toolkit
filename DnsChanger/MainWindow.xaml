                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource IpInfo_Timezone}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="MyIpTimezoneText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  بررسی IP دلخواه  -->
                    <Border Style="{StaticResource DnsCardStyle}" Cursor="Arrow" Padding="24">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource IpInfo_CheckCustom}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomIpBox" Grid.Column="0" Style="{StaticResource InputStyle}" Margin="0,0,10,0" Tag="{DynamicResource IpInfo_Placeholder}"/>
                                <Button Grid.Column="1" Content="{DynamicResource IpInfo_CheckButton}" Style="{StaticResource ApplyButtonStyle}" Padding="28,9" Click="CheckCustomIpButton_Click"/>
                            </Grid>

                            <Grid x:Name="CustomIpResultsPanel" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <!--  آیکون  -->
                                    <ColumnDefinition Width="18"/>
                                    <!--  فاصله‌ی ثابت  -->
                                    <ColumnDefinition Width="*"/>
                                    <!--  محتوا  -->
                                    <ColumnDefinition Width="14"/>
                                    <!--  فاصله‌ی ثابت  -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!--  بج Proxy  -->
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Background="{DynamicResource BgChip}" VerticalAlignment="Top">
                                    <Viewbox Width="22" Height="22" FlowDirection="LeftToRight">
                                        <Path Data="M12,2a8,8,0,0,0-8,8c0,5.4,7.05,11.5,7.35,11.76a1,1,0,0,0,1.3,0C13,21.5,20,15.4,20,10A8,8,0,0,0,12,2Zm0,17.65c-2.13-2-6-6.31-6-9.65a6,6,0,0,1,12,0C18,13.34,14.13,17.66,12,19.65ZM12,6a4,4,0,1,0,4,4A4,4,0,0,0,12,6Zm0,6a2,2,0,1,1,2-2A2,2,0,0,1,12,12Z" Fill="{DynamicResource AccentBlue}"/>
                                    </Viewbox>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="CustomIpAddressText" Text="—" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <UniformGrid Columns="3" Margin="0,12,0,0">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource IpInfo_CountryCity}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock x:Name="CustomIpLocationText" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{DynamicResource IpInfo_Isp}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock x:Name="CustomIpIspText" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource IpInfo_Timezone}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock x:Name="CustomIpTimezoneText" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>

                                <Border Grid.Column="4" x:Name="CustomIpProxyBadge" Background="{DynamicResource Danger}" CornerRadius="14" Padding="12,6" VerticalAlignment="Top" Visibility="Collapsed">
                                    <TextBlock Text="VPN / Proxy" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  ///////////////////// صفحه تنظیمات ///////////////////// -->
                <StackPanel x:Name="SettingsPagePanel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Settings_Title}" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings_Subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,20"/>

                    <Border Style="{StaticResource DnsCardStyle}" Cursor="Arrow">
                        <StackPanel>

                            <!--  حالت نمایش — کارت پیش‌نمایش دارک/لایت  -->
                            <TextBlock Text="{DynamicResource Settings_DisplayMode}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                                <Button x:Name="DarkModeButton" Style="{StaticResource SelectableOptionCardStyle}" Tag="Selected" Click="DarkModeButton_Click" Margin="0,0,14,0">
                                    <StackPanel Width="120">
                                        <Border Height="64" CornerRadius="8" Background="#0F1117">
                                            <Grid>
                                                <Border Height="16" VerticalAlignment="Top" Background="{DynamicResource AccentGradient}" CornerRadius="8,8,0,0"/>
                                                <Border Width="76" Height="28" CornerRadius="6" Background="#1A1D29" Margin="0,22,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Settings_DarkMode}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LightModeButton" Style="{StaticResource SelectableOptionCardStyle}" Click="LightModeButton_Click">
                                    <StackPanel Width="120">
                                        <Border Height="64" CornerRadius="8" Background="#F5F6FA">
                                            <Grid>
                                                <Border Height="16" VerticalAlignment="Top" Background="{DynamicResource AccentGradient}" CornerRadius="8,8,0,0"/>
                                                <Border Width="76" Height="28" CornerRadius="6" Background="White" Margin="0,22,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Settings_LightMode}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!--  رنگ لهجه — کارت‌های گرادینتی با تیک انتخاب  -->
                            <TextBlock Text="{DynamicResource Settings_ThemeColor}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                                <StackPanel Margin="0,0,18,0">
                                    <Button x:Name="AccentSwatchBluePurple" Style="{StaticResource AccentSwatchCardStyle}" Tag="Selected" Click="AccentSwatch_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#5B8CFF" Offset="0"/>
                                                <GradientStop Color="#8B5CF6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Color_BluePurple}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,0">
                                    <Button x:Name="AccentSwatchGreen" Style="{StaticResource AccentSwatchCardStyle}" Click="AccentSwatch_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#22C55E" Offset="0"/>
                                                <GradientStop Color="#0D9488" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Color_Green}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,0">
                                    <Button x:Name="AccentSwatchOrange" Style="{StaticResource AccentSwatchCardStyle}" Click="AccentSwatch_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F97316" Offset="0"/>
                                                <GradientStop Color="#DC2626" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Color_Orange}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,0">
                                    <Button x:Name="AccentSwatchPink" Style="{StaticResource AccentSwatchCardStyle}" Click="AccentSwatch_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#EC4899" Offset="0"/>
                                                <GradientStop Color="#7C3AED" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Color_Pink}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,0">
                                    <Button x:Name="AccentSwatchCyan" Style="{StaticResource AccentSwatchCardStyle}" Click="AccentSwatch_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#06B6D4" Offset="0"/>
                                                <GradientStop Color="#3B82F6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Color_Cyan}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,18,0">
                                    <Button x:Name="AccentSwatchRed" Style="{StaticResource AccentSwatchCardStyle}" Click="AccentSwatch_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#EF4444" Offset="0"/>
                                                <GradientStop Color="#BE123C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Color_Red}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <Button x:Name="AccentSwatchSlate" Style="{StaticResource AccentSwatchCardStyle}" Click="AccentSwatch_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#64748B" Offset="0"/>
                                                <GradientStop Color="#334155" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Color_Slate}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!--  زبان برنامه  -->
                            <TextBlock Text="{DynamicResource Settings_Language}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LangFaButton" Style="{StaticResource SelectableOptionCardStyle}" Tag="Selected" Click="Language_Click" Margin="0,0,14,0">
                                    <StackPanel Width="100">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BgChip}" HorizontalAlignment="Center">
                                            <TextBlock Text="FA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="فارسی" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LangEnButton" Style="{StaticResource SelectableOptionCardStyle}" Click="Language_Click">
                                    <StackPanel Width="100">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BgChip}" HorizontalAlignment="Center">
                                            <TextBlock Text="EN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="English" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Settings_LanguageNote}"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
            </ScrollViewer>
        </Grid>

        <!--  ===================== Toast Overlay پایین صفحه ===================== -->
        <Border x:Name="MessageBorder" Grid.Row="0" Grid.RowSpan="2" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,26" CornerRadius="24" Padding="18,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFF" Opacity="0.22" VerticalAlignment="Center">
                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="MessageTextBlock" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
