<Window x:Class="DnsChanger.CustomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Border Width="360" Padding="28,26" CornerRadius="16"
            Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.45" Color="Black"/>
        </Border.Effect>

        <StackPanel>

            <!--  آیکون دایره‌ای — بسته به نوع پیام یکی از این ۴ حالت نمایش داده میشه  -->
            <Border x:Name="IconCircle" Width="54" Height="54" CornerRadius="27" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Grid>
                    <Viewbox Width="24" Height="24" Visibility="Collapsed" x:Name="SuccessIcon" FlowDirection="LeftToRight">
                        <Path Data="M5 13l4 4L19 7" Stroke="White" StrokeThickness="2.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Viewbox>
                    <Viewbox Width="22" Height="22" Visibility="Collapsed" x:Name="ErrorIcon" FlowDirection="LeftToRight">
                        <Canvas Width="24" Height="24">
                            <Line X1="5" Y1="5" X2="19" Y2="19" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round"/>
                            <Line X1="19" Y1="5" X2="5" Y2="19" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <Viewbox Width="22" Height="22" Visibility="Collapsed" x:Name="WarningIcon" FlowDirection="LeftToRight">
                        <Canvas Width="24" Height="24">
                            <Line X1="12" Y1="4" X2="12" Y2="14" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round"/>
                            <Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="18" Fill="White"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="؟" FontSize="26" FontWeight="Bold" Foreground="White" Visibility="Collapsed" x:Name="QuestionIcon"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBlock x:Name="MessageText" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <PasswordBox x:Name="PasswordInput" Visibility="Collapsed" Margin="0,0,0,20" Padding="10,9"
                         FontSize="13" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CaretBrush="{DynamicResource AccentBlue}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="SecondaryButton" Content="انصراف" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="26,9" Margin="0,0,10,0" Click="SecondaryButton_Click" Visibility="Collapsed"/>
                <Button x:Name="PrimaryButton" Content="باشه" Style="{StaticResource ApplyButtonStyle}"
                        Padding="26,9" Click="PrimaryButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
