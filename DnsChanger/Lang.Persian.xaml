    <system:String x:Key="Log_WifiConnected">به Wi-Fi «{0}» متصل شد</system:String>
    <system:String x:Key="Log_DnsResetFromTray">DNS به حالت خودکار (DHCP) بازنشانی شد — از Tray</system:String>
    <system:String x:Key="Log_DiagnosticsFromTray">تشخیص و رفع خودکار از Tray اجرا شد</system:String>

